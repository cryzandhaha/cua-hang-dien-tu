    function renderFallbackOrders() {
      const container = document.getElementById('orderListContainer');
      container.innerHTML = `
        <div class="box">
          <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--border); padding-bottom:12px; margin-bottom:12px;">
            <div>
              <span style="font-weight:700; font-size:1.05rem;">Mã HĐ: <span class="schema-tag">HD0021</span></span>
