            <span class="schema-tag">Mục đích ① & ③: Quản lý kinh doanh & Báo cáo mặt hàng chủ lực</span>
          </div>
          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr><th>Mã SP</th><th>Tên Sản Phẩm</th><th>Số Lượng Bán</th><th>Doanh Thu Đóng Góp</th></tr>
              </thead>
