      `;
    }

    let revChartInstance = null, catChartInstance = null;
    function initCharts() {
      if (revChartInstance) revChartInstance.destroy();
      if (catChartInstance) catChartInstance.destroy();

      const revCtx = document.getElementById('revenueChart').getContext('2d');
      revChartInstance = new Chart(revCtx, {
        type: 'bar',
        data: {
          labels: ['Tháng 06/2026', 'Tháng 07/2026', 'Tháng 08/2026', 'Tháng 09/2026', 'Tháng 10/2026'],
          datasets: [
            { label: 'Doanh thu thuần (Q1)', data: [195, 210, 235, 248.5, 279.4], backgroundColor: '#2563eb', borderRadius: 6 },
            { label: 'Lợi nhuận gộp (Q3)', data: [42, 48, 55, 62.4, 71.2], backgroundColor: '#10b981', borderRadius: 6 }
          ]
        },
        options: { responsive: true, maintainAspectRatio: false }
      });

      const catCtx = document.getElementById('categoryChart').getContext('2d');
      catChartInstance = new Chart(catCtx, {
        type: 'doughnut',
        data: {
          labels: ['Linh kiện CPU/VGA (58.4%)', 'Laptop & PC (26.8%)', 'Phụ kiện & Màn hình (14.8%)'],
          datasets: [{ data: [58.4, 26.8, 14.8], backgroundColor: ['#2563eb', '#8b5cf6', '#06b6d4'] }]
        },
        options: { responsive: true, maintainAspectRatio: false }
      });
    }

    function showToast(msg) {
      const t = document.getElementById('toastNotification');
      document.getElementById('toastMsg').innerText = msg;
      t.classList.add('show');
      setTimeout(() => t.classList.remove('show'), 3500);
    }

    // KHỞI CHẠY LẦN ĐẦU
    window.onload = function() {
      loadProductsFromDB();
      loadUserInfo('KH001'); // Nạp đồng bộ thông tin khách hàng từ DB
      loadCustomersList();  // Nạp danh sách khách hàng cho bộ lọc
      renderCart();
      executeQ12();
      renderSpecificQuery('Q2');
    };
  </script>
</body>
</html>