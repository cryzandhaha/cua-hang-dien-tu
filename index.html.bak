                <tr><td><span class="schema-tag">SP002</span></td><td>CPU Intel Core i7-14700K Box</td><td><b>19 chiếc</b></td><td style="color:var(--primary); font-weight:700;">206,910,000 đ</td></tr>
                <tr><td><span class="schema-tag">SP003</span></td><td>RAM Corsair Vengeance RGB 32GB DDR5</td><td><b>18 chiếc</b></td><td style="color:var(--primary); font-weight:700;">55,800,000 đ</td></tr>
                <tr><td><span class="schema-tag">SP004</span></td><td>Màn hình Gaming ASUS ROG Swift OLED 27"</td><td><b>8 chiếc</b></td><td style="color:var(--primary); font-weight:700;">175,920,000 đ</td></tr>
              </tbody>
            </table>
          </div>
        `;
      } else if (qCode === 'Q5') {
        box.innerHTML = `
          <div class="box-header">
            <h3><i class="fa-solid fa-user-check"></i> Q5. Hiệu Suất Bán Hàng & Quy Trách Nhiệm Từng Nhân Viên</h3>
            <span class="schema-tag">Mục đích ③ & ④: Đánh giá KPI & Truy vết ai lập HĐ, ai thu tiền</span>
          </div>
          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr><th>Mã NV</th><th>Họ Tên</th><th>Chức Vụ</th><th>Số HĐ Đã Lập</th><th>Doanh Thu Bán Ra</th><th>Số GD Thu Tiền</th><th>Tổng Tiền Đã Thu</th><th>Số Ticket Xử Lý</th></tr>
              </thead>
              <tbody>
                <tr><td><span class="schema-tag">NV003</span></td><td><b>Trần Thị Bích</b></td><td>Nhân viên bán hàng</td><td>28 hóa đơn</td><td style="color:var(--primary); font-weight:700;">345,600,000 đ</td><td>32 lần</td><td style="color:var(--success); font-weight:700;">380,200,000 đ</td><td>8 ticket</td></tr>
                <tr><td><span class="schema-tag">NV002</span></td><td><b>Nguyễn Hoàng Nam</b></td><td>Nhân viên kỹ thuật</td><td>0 hóa đơn</td><td>0 đ</td><td>2 lần</td><td>15,400,000 đ</td><td>24 ticket</td></tr>
                <tr><td><span class="schema-tag">NV001</span></td><td><b>Phạm Quốc Tuấn</b></td><td>Trưởng cửa hàng</td><td>12 hóa đơn</td><td>182,400,000 đ</td><td>14 lần</td><td>190,000,000 đ</td><td>4 ticket</td></tr>
              </tbody>
            </table>
          </div>
        `;
      } else if (qCode === 'Q6') {
        box.innerHTML = `
          <div class="box-header">
            <h3><i class="fa-solid fa-crown"></i> Q6. Phân Hạng Khách Hàng Theo Chi Tiêu & Số Dư Credit</h3>
            <span class="schema-tag">Mục đích ① & ②: Chăm sóc khách hàng loyalty & Kiểm soát ví Credit</span>
          </div>
          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr><th>Mã KH</th><th>Họ Tên Khách Hàng</th><th>Số Điện Thoại</th><th>Số Đơn Đã Mua</th><th>Tổng Chi Tiêu</th><th>Số Dư Ví Credit</th><th>Hạng Khách</th></tr>
              </thead>
              <tbody>
                <tr><td><span class="schema-tag">KH001</span></td><td><b>Nguyễn Văn An</b></td><td>0988123456</td><td>5 đơn</td><td style="color:var(--primary); font-weight:700;">68,450,000 đ</td><td style="color:var(--accent); font-weight:700;">5,000,000 đ</td><td><span class="badge badge-vip"><i class="fa-solid fa-crown"></i> VIP (≥50tr)</span></td></tr>
                <tr><td><span class="schema-tag">KH004</span></td><td><b>Hoàng Minh Trí</b></td><td>0977889900</td><td>3 đơn</td><td>32,100,000 đ</td><td>1,200,000 đ</td><td><span class="badge badge-than-thiet">Thân thiết (≥20tr)</span></td></tr>
              </tbody>
            </table>
          </div>
        `;
      } else {
        box.innerHTML = `<div style="padding:20px; text-align:center; color:var(--text-muted);">Đã kết nối dữ liệu cho truy vấn ${qCode} từ file <code>04_queries_btl.sql</code>.</div>`;
      }
    }

